# Optional until an Anthropic-backed workflow node is enabled. Never commit real credentials.
ANTHROPIC_API_KEY=

# Anthropic model identifiers used by language recognition and conversation workflows.
ANTHROPIC_LANGUAGE_MODEL=claude-haiku-5-5
ANTHROPIC_CONVERSATION_MODEL=claude-haiku-5-5

# IANA timezone used to normalize reported_at at startup. Default operational value: Europe/Madrid.
LOCAL_TIMEZONE=Europe/Madrid

# Directory for one JSONL trace folder per local process run. Docker fixes this to /app/traces.
TRACES_DIR=traces

# Presentation-only slot grid for vague date requests (never availability evidence).
SLOT_LOOKAHEAD_DAYS=7
SLOT_DAILY_START_HOUR=9
SLOT_DAILY_END_HOUR=19
SLOT_HOURS=2
